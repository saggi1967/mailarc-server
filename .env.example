# mailarc-server Konfiguration

# Ziel-Datenbank. Default SQLite (sofort lauffähig). Für Produktion Postgres:
#   DATABASE_URL=postgresql+psycopg://mailarc:geheim@localhost:5432/mailarc
DATABASE_URL=sqlite:///./mailarc_server.db

# Muss identisch zum REST_API_TOKEN der Clients sein (Bearer-Auth).
API_TOKEN=

# Fernet-Schlüssel zum Verschlüsseln der IMAP-Passwörter. Einmalig erzeugen mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WICHTIG: Ändert sich der Schlüssel, sind bereits gespeicherte Passwörter nicht
# mehr entschlüsselbar (Konten dann per 'account update' neu setzen).
SECRET_KEY=

# Lease-Dauer der Per-Ordner-Sync-Locks in Sekunden.
LOCK_TTL_SECONDS=300

# ── client-API (Web-UI / Rich-Client, /api) ─────────────────────────────────
# Web-Login. Ohne WEB_PASSWORD ist der Login deaktiviert (Frontend meldet
# "Login gesperrt"). Das Session-Cookie wird mit SECRET_KEY signiert.
WEB_USERNAME=admin
WEB_PASSWORD=
# Erlaubte Frontend-Origins (CORS, Komma-getrennt). Default deckt den Vite-Dev-Server ab.
WEB_ORIGINS=http://localhost:5173
# In Produktion hinter HTTPS: WEB_COOKIE_SECURE=true; bei fremder Domain WEB_COOKIE_SAMESITE=none
# WEB_COOKIE_SECURE=false
# WEB_COOKIE_SAMESITE=lax

# Elasticsearch für /api/search (gleiche Instanz/Index wie der CLI-Indexlauf).
# Im Docker-Container ist "localhost" der Container selbst — für ES auf dem Host
# host.docker.internal verwenden (macOS/Windows) bzw. den ES-Service-Namen im Compose.
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=
ES_INDEX=emails
# ES_VERIFY_CERTS=true
