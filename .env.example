# mailarc-server Konfiguration

# Ziel-Datenbank. Default SQLite (sofort lauffähig). Für Produktion Postgres:
#   DATABASE_URL=postgresql+psycopg://mailarc:geheim@localhost:5432/mailarc
DATABASE_URL=sqlite:///./mailarc_server.db

# Muss identisch zum REST_API_TOKEN der Clients sein (Bearer-Auth).
API_TOKEN=

# Fernet-Schlüssel zum Verschlüsseln der IMAP-Passwörter. Einmalig erzeugen mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WICHTIG: Ändert sich der Schlüssel, sind bereits gespeicherte Passwörter nicht
# mehr entschlüsselbar (Konten dann per 'account update' neu setzen).
SECRET_KEY=

# Lease-Dauer der Per-Ordner-Sync-Locks in Sekunden.
LOCK_TTL_SECONDS=300
